{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // Vite bundles the app, so TypeScript is used for checking only.
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    // Keeps unused React imports and switch fallthroughs from becoming runtime surprises
    // in components, matching the backend's strictness.
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts", "vitest.config.ts"]
}
