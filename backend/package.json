{
  "name": "@sfs/backend",
  "version": "0.1.0",
  "private": true,
  "description": "School Finance System REST API.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "prepare:deps": "npm run build -w @sfs/shared && prisma generate",
    "predev": "npm run prepare:deps",
    "dev": "tsx watch src/index.ts",
    "prebuild": "npm run prepare:deps",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "pretypecheck": "npm run prepare:deps",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run prepare:deps",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@sfs/shared": "^0.1.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "otpauth": "^9.5.2",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.10.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13"
  }
}
