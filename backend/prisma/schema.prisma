// School Finance System -- database schema.
//
// Phase 0 establishes the datasource, the generated client and the migration pipeline.
// The domain model (schools, users, roles, students, parents, academic years, terms,
// classes, programmes, enrolments, fee structures, charges, payments, receipts,
// adjustments, reconciliations, clearances, audit logs) is introduced in Phase 1 with
// `school_id` tenant scoping built in from the first migration (Section 5).
//
// Conventions fixed here and applied to every model added later:
//   - Monetary columns are `Decimal @db.Decimal(14, 2)`; never Float, never Int.
//   - Timestamps are `DateTime @db.Timestamptz(3)`, stored in UTC (Section 27).
//   - Identifiers are UUIDs generated by the database.
//   - Frequently co-edited rows carry a `version Int` column for optimistic locking.
//   - Table and column names are snake_case via `@@map` / `@map`.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

// Prisma 7 no longer accepts a connection URL here. Migrate and introspect read it from
// `prisma.config.ts`; the runtime client receives it through a driver adapter
// (see `src/lib/prisma.ts`). One consequence worth knowing: there is no path by which a
// stray schema file can point a migration at the wrong database.
datasource db {
  provider = "postgresql"
}
