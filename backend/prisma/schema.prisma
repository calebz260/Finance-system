// School Finance System -- database schema.
//
// Conventions applied to every model here and in later phases:
//   - Monetary columns are `Decimal @db.Decimal(14, 2)`; never Float, never Int.
//   - Timestamps are `DateTime @db.Timestamptz(3)`, stored in UTC (Section 27).
//   - Primary keys are database-generated UUIDs.
//   - Tables and columns are snake_case via `@@map` / `@map`.
//   - Every tenant-scoped table carries `school_id` (Section 5). Logical uniqueness is
//     declared per school, so two schools can each have a student `STU-2026-00001`.
//   - Frequently co-edited rows carry `version` for optimistic locking (Section 13).
//   - History is appended, never overwritten: a promotion creates a new enrolment.
//
// Constraints Prisma cannot express -- partial unique indexes and check constraints --
// live in `migrations/*_domain_constraints/migration.sql`. They are listed next to the
// models they protect so they are not forgotten during a schema change.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

// Prisma 7 no longer accepts a connection URL here. Migrate and introspect read it from
// `prisma.config.ts`; the runtime client receives it through a driver adapter
// (see `src/lib/prisma.ts`). One consequence worth knowing: there is no path by which a
// stray schema file can point a migration at the wrong database.
datasource db {
  provider = "postgresql"
}

/// ---------------------------------------------------------------------------- enums

enum SchoolStatus {
  ACTIVE
  INACTIVE

  @@map("school_status")
}

/// What happens to a term's charges when a student leaves part-way through (Section 8).
/// Configured per school; never hard-coded in business logic.
enum MidPeriodChargePolicy {
  /// The full term charge stands.
  FULL_TERM_CHARGE
  /// Charge is prorated by days attended.
  PRORATE_BY_DAYS
  /// Full charge stands, and any overpayment is returned through the refund workflow.
  REFUND_VIA_WORKFLOW

  @@map("mid_period_charge_policy")
}

enum UserStatus {
  /// Created, but the person has not yet set a password.
  INVITED
  ACTIVE
  /// Temporarily blocked by an administrator.
  SUSPENDED
  /// Automatically blocked after repeated failed sign-in attempts.
  LOCKED
  /// Permanently deactivated; retained for audit history.
  DISABLED

  @@map("user_status")
}

enum PeriodStatus {
  /// Configured, not yet begun.
  UPCOMING
  ACTIVE
  /// Ended and closed for new financial activity.
  CLOSED

  @@map("period_status")
}

enum ProgramStatus {
  ACTIVE
  /// No longer offered to new students; retained because historical records reference it.
  DISCONTINUED

  @@map("program_status")
}

enum Gender {
  FEMALE
  MALE
  OTHER
  UNDISCLOSED

  @@map("gender")
}

enum ResidencyType {
  DAY
  BOARDING

  @@map("residency_type")
}

/// Where a student is in their life at the school (Section 8).
enum StudentStatus {
  /// Registered and currently enrolled.
  ACTIVE
  /// Finished the final level of their programme.
  COMPLETED
  /// Moved to another school.
  TRANSFERRED
  /// Left before completing, by choice or otherwise.
  WITHDRAWN
  /// Temporarily not attending, expected to return.
  SUSPENDED
  /// Former student kept for financial history and clearance checks.
  ARCHIVED

  @@map("student_status")
}

enum EnrollmentStatus {
  /// The student's current, active enrolment for that year.
  ENROLLED
  /// Completed the year and moved up.
  PROMOTED
  /// Completed the year and is repeating the same level.
  REPEATED
  /// Finished the final level of the programme.
  COMPLETED
  /// Left for another school part-way through or at the end.
  TRANSFERRED_OUT
  /// Left the school without completing.
  WITHDRAWN

  @@map("enrollment_status")
}

enum EnrollmentType {
  /// First ever enrolment at this school.
  NEW
  /// Promoted from the previous year at this school.
  CONTINUING
  /// Repeating the level they were in last year.
  REPEAT
  /// Returning after a period away.
  RE_ADMISSION
  /// Arrived from another school.
  TRANSFER_IN

  @@map("enrollment_type")
}

enum GuardianRelationship {
  MOTHER
  FATHER
  GUARDIAN
  SIBLING
  SPONSOR
  OTHER

  @@map("guardian_relationship")
}

/// ------------------------------------------------------------------ fees (Phase 4)

/// Lifecycle of a fee structure. A structure is a *template*; once it has raised
/// charges it stops being editable, because a structure that can be rewritten after the
/// fact makes every historical charge unexplainable (Section 12).
enum FeeStructureStatus {
  /// Being configured. Items may be added, changed and removed.
  DRAFT
  /// Published and usable for charge generation.
  ACTIVE
  /// Withdrawn from use. Never deleted: historical charges point at it.
  ARCHIVED

  @@map("fee_structure_status")
}

/// A charge's lifecycle, deliberately *not* its financial state.
///
/// Whether a charge is settled is derived by the balance service from credits against
/// it, never stored — a stored "paid" flag is the manually editable balance the whole
/// design refuses (Section 13A).
enum ChargeStatus {
  /// A live obligation.
  RAISED
  /// Raised in error and withdrawn. Excluded from balances, retained for history.
  VOID

  @@map("charge_status")
}

/// Which way a ledger entry moves an account.
///
/// A charge debits, relief and payments credit. Direction is carried here rather than by
/// the sign of `amount`, so every stored amount is positive and no call site has to
/// remember a sign convention to read the ledger.
enum EntryDirection {
  DEBIT
  CREDIT

  @@map("entry_direction")
}

/// What kind of business record produced a ledger entry.
///
/// The ledger is the authoritative balance, but an entry on its own says only "credit
/// 20,000". This names the record that justifies it, so a balance can always be traced
/// back to the decision behind each line.
enum FinancialEntrySource {
  CHARGE
  DISCOUNT
  SCHOLARSHIP
  WAIVER
  ADJUSTMENT
  /// A verified payment (Phase 5). Added as a *value* rather than as a new concept,
  /// which is what made introducing payments a new entry source instead of a change to
  /// how money is counted: a payment CREDITs, a reversal or refund posts the opposing
  /// DEBIT, and the balance formula is untouched.
  PAYMENT

  @@map("financial_entry_source")
}

/// How a relief amount was arrived at. The resolved amount is always stored; the method
/// is kept so a percentage award can be explained and re-checked years later.
enum AdjustmentMethod {
  FIXED
  PERCENTAGE

  @@map("adjustment_method")
}

/// Approval state, shared by every record that reduces or increases what a family owes.
///
/// A bursar may request; only a Finance Manager may approve (`adjustment.approve` in the
/// role matrix). Nothing reaches the ledger until APPROVED.
enum ApprovalStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  /// Withdrawn by the requester before a decision was made.
  CANCELLED
  /// Approved, then reversed. The original record is preserved and an opposing ledger
  /// entry is posted, because deleting an approved decision would erase it.
  REVERSED

  @@map("approval_status")
}

/// Whether a student's financial account is open to new activity.
enum FinancialAccountStatus {
  ACTIVE
  /// Closed after a student leaves. History stays readable; nothing new is posted.
  CLOSED

  @@map("financial_account_status")
}

/// Outcome of a bulk charge-generation run.
enum ChargeRunStatus {
  /// Validated and costed, nothing written.
  PREVIEWED
  /// Committed inside one transaction.
  APPLIED

  @@map("charge_run_status")
}

enum AuditResult {
  SUCCESS
  FAILURE

  @@map("audit_result")
}

/// -------------------------------------------------------------- payments (Phase 5)

/// How the money physically moved.
///
/// Deliberately independent of `PaymentVerificationMethod`: the same bank transfer may be
/// confirmed by a provider callback at one bank and by a bursar reading a statement at
/// another, and collapsing the two would mean the verification rules changed whenever a
/// bank's integration did.
enum PaymentMethod {
  /// Mobile wallet push/pull, provider-confirmed where an adapter exists.
  MOBILE_MONEY
  /// Transfer into the school's collection account.
  BANK_TRANSFER
  /// Over-the-counter deposit at a branch or agent.
  BANK_DEPOSIT
  /// Handed over at the bursar's office.
  CASH
  CHEQUE

  @@map("payment_method")
}

/// What has to happen before a payment may credit the ledger (ADR-003).
enum PaymentVerificationMethod {
  /// A provider confirms it, and the confirmation is verified against the provider's own
  /// record server-side before anything is credited.
  PROVIDER
  /// An authorised bursar confirms it against a statement or the cash in hand. A
  /// first-class path, not an exception path — it may carry most of the real volume.
  MANUAL

  @@map("payment_verification_method")
}

/// A payment's lifecycle.
///
/// `SUCCESSFUL` is the only status that has credited the ledger, and it is reached only
/// through server-side verification. Permitted transitions are declared once, in
/// `shared/src/api.ts`, and enforced by `payment.status.ts`; a status column alone cannot
/// express "never backwards out of a terminal state", which is the rule that stops a
/// repeated callback resurrecting a failed payment.
///
/// The two undo states are distinct on purpose: REVERSED means the money never really
/// arrived, REFUNDED means it arrived and was sent back. Both post a compensating ledger
/// entry; neither deletes anything.
enum PaymentStatus {
  /// Created. A provider payment is awaiting the provider; a manual claim is awaiting a
  /// bursar. Nothing has been credited.
  PENDING
  /// The provider has accepted the request and is working on it.
  PROCESSING
  /// Verified and credited. The one status that has moved the balance.
  SUCCESSFUL
  FAILED
  /// Withdrawn before it completed.
  CANCELLED
  /// Something did not add up — an amount or currency mismatch, an unrecognised
  /// reference. Parked for a person rather than resolved silently (Section 20).
  REQUIRES_REVIEW
  /// Credited, then found not to have arrived. The original is preserved.
  REVERSED
  /// Credited, then genuinely returned to the payer.
  REFUNDED

  @@map("payment_status")
}

/// The channels the school collects through.
///
/// `SANDBOX` is a local simulator used in development and tests. It is not a bank, it
/// makes no outbound calls, and it is refused outright in production. The three named
/// Rwandan channels exist as values so a payment can record which one it came through
/// even while that channel is reconciled by hand; see docs/OPEN-QUESTIONS.md #1 and #2.
enum PaymentProviderKey {
  SANDBOX
  BANK_OF_KIGALI
  ZIGAMA_CSS
  UMWARIMU_SACCO

  @@map("payment_provider_key")
}

/// One attempt against a provider.
///
/// `UNKNOWN` is a real outcome rather than a missing one: a timed-out request may still
/// have taken the payer's money, so it must be representable and must not be treated as
/// a failure.
enum PaymentTransactionStatus {
  INITIATED
  PENDING
  SUCCEEDED
  FAILED
  TIMED_OUT
  UNKNOWN

  @@map("payment_transaction_status")
}

/// Who or what caused a status transition.
enum PaymentStatusChangeSource {
  USER
  PROVIDER_WEBHOOK
  PROVIDER_QUERY
  SYSTEM

  @@map("payment_status_change_source")
}

/// What a piece of proof attached to a manual claim actually is.
enum PaymentEvidenceKind {
  BANK_SLIP
  TRANSFER_CONFIRMATION
  REMITTANCE_ADVICE
  OTHER

  @@map("payment_evidence_kind")
}

/// Whether an uploaded file's bytes were checked for malicious content.
///
/// `SKIPPED` is recorded rather than implied when no scanner is configured, because a
/// reviewer opening a bank slip needs to know which of the two it is. Phase 5 ships the
/// port and the state; a scanner is an external dependency the school has to provide.
enum ContentScanState {
  PENDING
  CLEAN
  INFECTED
  SKIPPED

  @@map("content_scan_state")
}

/// Outcome of verifying an inbound provider callback.
enum WebhookVerificationResult {
  VERIFIED
  /// The signature did not match the shared secret.
  SIGNATURE_INVALID
  /// Correctly signed, but the timestamp is outside the accepted window: a replay.
  REPLAYED
  /// Signed and fresh, but the body could not be understood.
  MALFORMED
  /// Signed and fresh, but names a payment or transaction this school does not have.
  UNKNOWN_REFERENCE

  @@map("webhook_verification_result")
}

/// Which counter an `IdentifierSequence` row tracks.
enum SequenceKind {
  /// Student IDs: `STU-2026-00125`
  STUDENT
  /// Receipt numbers: `RCP-2026-000001234`
  RECEIPT
  /// Payment references: `PAY-2026-000001234`
  PAYMENT

  @@map("sequence_kind")
}

/// ------------------------------------------------------------------- tenant: school

/// The tenant boundary. Only one school uses the system at launch, but every scoped
/// table references this one so a second school is a configuration change rather than a
/// data migration across live financial records (Section 5).
model School {
  id        String       @id @default(uuid()) @db.Uuid
  /// Short human-facing code, e.g. "GSKICUKIRO".
  code      String       @unique
  name      String
  shortName String?      @map("short_name")
  motto     String?
  email     String?
  phone     String?
  /// Rwandan administrative hierarchy, kept as plain text because it changes over time.
  district  String?
  sector    String?
  cell      String?
  address   String?
  logoUrl   String?      @map("logo_url")
  status    SchoolStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  version   Int      @default(0)

  settings             SchoolSetting?
  users                User[]
  roleAssignments      UserRole[]
  departments          Department[]
  programs             Program[]
  levels               Level[]
  classSections        ClassSection[]
  academicYears        AcademicYear[]
  terms                Term[]
  students             Student[]
  guardians            Guardian[]
  studentGuardians     StudentGuardian[]
  enrollments          Enrollment[]
  auditLogs            AuditLog[]
  identifierSequences  IdentifierSequence[]
  feeCategories        FeeCategory[]
  feeStructures        FeeStructure[]
  feeStructureItems    FeeStructureItem[]
  chargeRuns           ChargeRun[]
  studentCharges       StudentCharge[]
  discounts            Discount[]
  scholarships         Scholarship[]
  studentScholarships  StudentScholarship[]
  feeWaivers           FeeWaiver[]
  financialAdjustments FinancialAdjustment[]
  financialAccounts    StudentFinancialAccount[]
  financialEntries     FinancialEntry[]
  payments             Payment[]
  paymentTransactions  PaymentTransaction[]
  paymentStatusHistory PaymentStatusHistory[]
  paymentEvidence      PaymentEvidence[]
  paymentWebhookEvents PaymentWebhookEvent[]
  statementImports     BankStatementImport[]
  statementLines       BankStatementLine[]

  @@map("schools")
}

/// Per-school, per-year counters for human-facing identifiers.
///
/// A dedicated counter rather than `MAX(student_id) + 1`: the latter races under
/// concurrent registration and during bulk import, and two students sharing a Student ID
/// would corrupt every financial record that references it. `UPDATE ... SET last_value =
/// last_value + 1 RETURNING last_value` is atomic, so allocation is safe without an
/// explicit lock (see `src/lib/identifier-sequence.ts`).
model IdentifierSequence {
  id        String       @id @default(uuid()) @db.Uuid
  schoolId  String       @map("school_id") @db.Uuid
  kind      SequenceKind
  /// Calendar year the counter belongs to; counters restart each year.
  year      Int
  lastValue Int          @default(0) @map("last_value")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, kind, year])
  @@map("identifier_sequences")
}

/// Per-school policy. These exist as data rather than code because they are exactly the
/// decisions a school changes without wanting a software release (Section 45).
model SchoolSetting {
  id       String @id @default(uuid()) @db.Uuid
  schoolId String @unique @map("school_id") @db.Uuid

  /// ISO-4217 code. Display formatting is derived from it in `shared/src/money.ts`.
  currency String @default("RWF") @db.VarChar(3)
  /// IANA zone used when rendering timestamps. Storage is always UTC.
  timeZone String @default("Africa/Kigali") @map("time_zone")

  /// --- student and receipt identifiers (Section 7, 16)
  studentIdPrefix     String @default("STU") @map("student_id_prefix")
  receiptNumberPrefix String @default("RCP") @map("receipt_number_prefix")

  /// --- payment policy (Section 13A). Confirmation pending; see docs/OPEN-QUESTIONS.md.
  allowPartialPayments Boolean @default(true) @map("allow_partial_payments")
  /// Smallest accepted payment. Zero means no minimum.
  minimumPaymentAmount Decimal @default(0) @map("minimum_payment_amount") @db.Decimal(14, 2)

  /// --- lifecycle policy (Section 8)
  midPeriodChargePolicy MidPeriodChargePolicy @default(FULL_TERM_CHARGE) @map("mid_period_charge_policy")

  /// --- controls (Section 13B)
  /// When true, the bursar who verifies a manual payment claim may not be the one who
  /// submitted it. Relaxable because a small school may have a single bursar.
  enforceVerificationSeparationOfDuties Boolean @default(true) @map("enforce_verification_separation_of_duties")

  /// --- retention (Sections 20, 24). Placeholders pending confirmation with the school.
  /// Financial totals and audit entries are never deleted; these govern the deletion of
  /// identifying personal data only.
  financialRecordRetentionYears Int @default(10) @map("financial_record_retention_years")
  personalDataRetentionYears    Int @default(10) @map("personal_data_retention_years")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  version   Int      @default(0)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("school_settings")
}

/// --------------------------------------------------------- identity and permissions

/// A login account. Staff, parents and students all authenticate through this table;
/// what they may do comes from their role assignments, never from a column here.
model User {
  id String @id @default(uuid()) @db.Uuid

  /// Null only for a system-wide Super Administrator, who is not scoped to one school.
  /// A check constraint enforces that every other user has a school.
  schoolId String? @map("school_id") @db.Uuid

  /// Globally unique: one person, one account, even across schools.
  email     String  @unique
  phone     String?
  firstName String  @map("first_name")
  lastName  String  @map("last_name")

  /// Argon2id digest. Never selected by default -- repositories choose fields explicitly.
  passwordHash       String   @map("password_hash")
  passwordChangedAt  DateTime @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  /// Set for seeded and administrator-created accounts so the first sign-in forces a change.
  mustChangePassword Boolean  @default(false) @map("must_change_password")

  status UserStatus @default(INVITED)

  /// True for the Super Administrator, whose access is not scoped to a single school.
  isSystemAdministrator Boolean @default(false) @map("is_system_administrator")

  /// --- multi-factor authentication (Section 6)
  /// Whether TOTP is active. A check constraint enforces that an enabled account has a
  /// secret, so "MFA on, no secret" -- which would lock the user out -- cannot exist.
  mfaEnabled                Boolean   @default(false) @map("mfa_enabled")
  /// AES-256-GCM ciphertext, never the raw secret (see `src/lib/crypto.ts`).
  mfaSecretEncrypted        String?   @map("mfa_secret_encrypted")
  /// Secret issued during enrolment, held here until a first valid code confirms it, so
  /// an abandoned enrolment cannot leave the account half-configured.
  mfaPendingSecretEncrypted String?   @map("mfa_pending_secret_encrypted")
  mfaEnrolledAt             DateTime? @map("mfa_enrolled_at") @db.Timestamptz(3)
  /// Highest TOTP step counter already accepted. Blocks replay of an observed code.
  mfaLastUsedCounter        Int?      @map("mfa_last_used_counter")

  /// --- sign-in security (Section 25)
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  /// Set when the account is locked after repeated failures; cleared on success.
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(3)
  lastLoginAt         DateTime? @map("last_login_at") @db.Timestamptz(3)
  lastLoginIp         String?   @map("last_login_ip")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Deactivation is a status, not a deletion. Present only for accounts that must be
  /// withdrawn from use while their audit history is retained.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  version   Int       @default(0)

  school          School?              @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  roleAssignments UserRole[]           @relation("UserRoleHolder")
  rolesAssigned   UserRole[]           @relation("UserRoleAssigner")
  guardianProfile Guardian?
  auditLogs       AuditLog[]
  sessions        Session[]
  recoveryCodes   MfaRecoveryCode[]
  passwordResets  PasswordResetToken[]

  // Financial actions are attributed to a person, never to "the system" (Section 27).
  chargeRunsExecuted ChargeRun[]     @relation("ChargeRunExecutor")
  chargesRaised      StudentCharge[] @relation("ChargeRaiser")
  chargesVoided      StudentCharge[] @relation("ChargeVoider")

  discountsRequested    Discount[]            @relation("DiscountRequester")
  discountsDecided      Discount[]            @relation("DiscountApprover")
  discountsReversed     Discount[]            @relation("DiscountReverser")
  scholarshipsRequested StudentScholarship[]  @relation("ScholarshipRequester")
  scholarshipsDecided   StudentScholarship[]  @relation("ScholarshipApprover")
  scholarshipsReversed  StudentScholarship[]  @relation("ScholarshipReverser")
  waiversRequested      FeeWaiver[]           @relation("WaiverRequester")
  waiversDecided        FeeWaiver[]           @relation("WaiverApprover")
  waiversReversed       FeeWaiver[]           @relation("WaiverReverser")
  adjustmentsRequested  FinancialAdjustment[] @relation("AdjustmentRequester")
  adjustmentsDecided    FinancialAdjustment[] @relation("AdjustmentApprover")
  adjustmentsReversed   FinancialAdjustment[] @relation("AdjustmentReverser")
  entriesPosted         FinancialEntry[]      @relation("EntryPoster")

  paymentsInitiated       Payment[]              @relation("PaymentInitiator")
  paymentsVerified        Payment[]              @relation("PaymentVerifier")
  paymentsReversed        Payment[]              @relation("PaymentReverser")
  paymentStatusChanges    PaymentStatusHistory[] @relation("PaymentStatusActor")
  paymentEvidenceUploaded PaymentEvidence[]      @relation("EvidenceUploader")
  statementsImported      BankStatementImport[]  @relation("StatementImporter")
  statementLinesMatched   BankStatementLine[]    @relation("StatementMatcher")

  @@index([schoolId])
  @@index([schoolId, status])
  @@map("users")
}

/// ------------------------------------------------------------------- sessions

/// One sign-in. Sessions are held server-side rather than being implied by a
/// self-contained token, because this system needs revocation to be *immediate*:
/// suspending a bursar or removing a role must take effect on their next request, not
/// whenever an access token happens to expire.
///
/// The access token is a short-lived JWT that names this session; every authenticated
/// request re-reads the session, the account status and the current permissions.
model Session {
  id       String  @id @default(uuid()) @db.Uuid
  userId   String  @map("user_id") @db.Uuid
  /// The school the session is scoped to, copied at sign-in. Null for a Super
  /// Administrator's cross-school session.
  schoolId String? @map("school_id") @db.Uuid

  /// Whether the MFA challenge was completed. A session that never satisfied MFA cannot
  /// be upgraded later without signing in again.
  mfaSatisfied Boolean @default(false) @map("mfa_satisfied")

  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")

  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  /// Absolute end of the session, regardless of activity.
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// Why it ended: `logout`, `logout_all`, `token_reuse_detected`, `password_changed`,
  /// `account_suspended`, `roles_changed`. Recorded because "why am I signed out?" is a
  /// real support question, and because token reuse is a security event.
  revokedReason String?   @map("revoked_reason")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

/// A refresh token in a session's rotation chain.
///
/// Each refresh consumes one token and issues the next, so a chain accumulates. That is
/// what makes theft detectable: if a token that has already been used is presented
/// again, either the legitimate client replayed it or an attacker stole it, and there is
/// no way to tell which -- so the whole session is revoked. Silently issuing a new token
/// would let a thief ride along indefinitely.
///
/// Only the SHA-256 hash is stored; the token itself exists solely in the client cookie.
model RefreshToken {
  id        String @id @default(uuid()) @db.Uuid
  sessionId String @map("session_id") @db.Uuid
  tokenHash String @unique @map("token_hash")

  issuedAt     DateTime  @default(now()) @map("issued_at") @db.Timestamptz(3)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  /// When this token was exchanged. A second presentation after this is set is a reuse.
  usedAt       DateTime? @map("used_at") @db.Timestamptz(3)
  /// The token issued in its place, so the chain can be walked during an investigation.
  replacedById String?   @unique @map("replaced_by_id") @db.Uuid

  session    Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken? @relation("TokenRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   RefreshToken? @relation("TokenRotation")

  @@index([sessionId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Single-use codes that let someone with MFA enabled sign in after losing their phone.
///
/// Stored as SHA-256 hashes: the codes are 100 bits of generated randomness, so there is
/// no dictionary to attack and a slow KDF would add latency without adding security.
/// Used codes are kept, with `usedAt` set, so "was a recovery code used?" is answerable
/// during an incident.
model MfaRecoveryCode {
  id       String    @id @default(uuid()) @db.Uuid
  userId   String    @map("user_id") @db.Uuid
  codeHash String    @unique @map("code_hash")
  usedAt   DateTime? @map("used_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@map("mfa_recovery_codes")
}

/// A password-reset grant.
///
/// Single-use and short-lived. Stored as a hash, so a database reader cannot mint a
/// reset; and `usedAt` is recorded rather than the row being deleted, so a reset that
/// was already consumed is distinguishable from one that never existed.
model PasswordResetToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt      DateTime? @map("used_at") @db.Timestamptz(3)
  /// Where the request came from, for abuse investigation.
  requestedIp String?   @map("requested_ip")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

/// A named set of permissions. Roles are a system catalogue shared by all schools; what
/// varies per school is who holds them, which is why `UserRole` carries the school and
/// this table does not.
model Role {
  id          String  @id @default(uuid()) @db.Uuid
  /// Stable machine key, e.g. `BURSAR`. Business logic refers to this, never the name.
  key         String  @unique
  name        String
  description String?
  /// Higher means more privileged. Used to stop a user granting a role above their own.
  rank        Int     @default(0)
  /// System roles cannot be deleted or renamed through the application.
  isSystem    Boolean @default(true) @map("is_system")
  /// Roles that must complete a TOTP challenge to sign in (Section 6).
  requiresMfa Boolean @default(false) @map("requires_mfa")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  permissions RolePermission[]
  assignments UserRole[]

  @@map("roles")
}

/// A single capability, e.g. `payment.verify_manual`. Permissions are checked by key on
/// the backend; the frontend only uses them to decide what to show.
model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique
  /// Domain the permission belongs to, e.g. `payment`. Useful for grouping in the UI.
  resource    String
  action      String
  description String?
  /// Sensitive permissions (adjustments, reversals, refunds) are highlighted in audit
  /// reports and may require additional authorisation.
  isSensitive Boolean @default(false) @map("is_sensitive")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  roles RolePermission[]

  @@index([resource])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// Grants a role to a user within a school. The school is on the assignment, not the
/// role, so the same person could hold different roles at different schools.
model UserRole {
  id       String  @id @default(uuid()) @db.Uuid
  userId   String  @map("user_id") @db.Uuid
  roleId   String  @map("role_id") @db.Uuid
  /// Null only for a system-wide Super Administrator assignment.
  schoolId String? @map("school_id") @db.Uuid

  assignedByUserId String?  @map("assigned_by_user_id") @db.Uuid
  assignedAt       DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)

  user           User    @relation("UserRoleHolder", fields: [userId], references: [id], onDelete: Cascade)
  role           Role    @relation(fields: [roleId], references: [id], onDelete: Restrict)
  school         School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignedByUser User?   @relation("UserRoleAssigner", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([schoolId, roleId])
  // A partial unique index in the constraints migration prevents granting the same role
  // twice within one school, which a plain unique cannot do because `school_id` is
  // nullable and PostgreSQL treats NULLs as distinct.
  @@map("user_roles")
}

/// ------------------------------------------------------------- academic structure

/// Configurable grouping for programmes, e.g. "Sciences", "TVET".
model Department {
  id          String  @id @default(uuid()) @db.Uuid
  schoolId    String  @map("school_id") @db.Uuid
  code        String
  name        String
  description String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  school   School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  programs Program[]

  @@unique([schoolId, code])
  @@index([schoolId])
  @@map("departments")
}

/// A course of study: O'Level, an A'Level combination, or a TVET trade. Nothing about
/// O'Level, A'Level or TVET is hard-coded -- a school administrator configures
/// programmes and their levels, and promotion follows the level chain (Section 9).
model Program {
  id            String        @id @default(uuid()) @db.Uuid
  schoolId      String        @map("school_id") @db.Uuid
  departmentId  String?       @map("department_id") @db.Uuid
  code          String
  name          String
  description   String?
  /// Nominal length, used for planning and reports rather than for promotion logic,
  /// which follows the level chain.
  durationYears Int?          @map("duration_years")
  status        ProgramStatus @default(ACTIVE)
  sortOrder     Int           @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  version   Int      @default(0)

  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  department    Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  levels        Level[]
  enrollments   Enrollment[]
  feeStructures FeeStructure[]

  @@unique([schoolId, code])
  @@index([schoolId, status])
  @@map("programs")
}

/// A stage within a programme: S1, S2, S3 for O'Level; L3, L4, L5 for a TVET trade.
///
/// `sequence` orders them and `nextLevelId` chains them, so end-of-year promotion is a
/// data lookup rather than a rule in code. `isTerminal` marks the level after which a
/// student has completed the programme.
model Level {
  id          String  @id @default(uuid()) @db.Uuid
  schoolId    String  @map("school_id") @db.Uuid
  programId   String  @map("program_id") @db.Uuid
  code        String
  name        String
  sequence    Int
  isTerminal  Boolean @default(false) @map("is_terminal")
  nextLevelId String? @unique @map("next_level_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  program       Program        @relation(fields: [programId], references: [id], onDelete: Cascade)
  nextLevel     Level?         @relation("LevelProgression", fields: [nextLevelId], references: [id], onDelete: SetNull)
  previousLevel Level?         @relation("LevelProgression")
  classSections ClassSection[]
  enrollments   Enrollment[]
  feeStructures FeeStructure[]

  @@unique([schoolId, programId, code])
  @@unique([schoolId, programId, sequence])
  @@index([schoolId])
  @@map("levels")
}

/// A teaching group within a level for one academic year, e.g. "S1 A" in 2026.
///
/// Scoped to an academic year because sections, capacities and class teachers are set
/// afresh each year, and because current enrolment counts per class must be answerable
/// for the current year alone (Section 11).
model ClassSection {
  id               String  @id @default(uuid()) @db.Uuid
  schoolId         String  @map("school_id") @db.Uuid
  academicYearId   String  @map("academic_year_id") @db.Uuid
  levelId          String  @map("level_id") @db.Uuid
  code             String
  name             String
  capacity         Int?
  /// Optional class teacher. Kept as a plain name until staff records exist.
  classTeacherName String? @map("class_teacher_name")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  version   Int      @default(0)

  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear  AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  level         Level          @relation(fields: [levelId], references: [id], onDelete: Restrict)
  enrollments   Enrollment[]
  feeStructures FeeStructure[]

  @@unique([schoolId, academicYearId, levelId, code])
  @@index([schoolId, academicYearId])
  @@map("class_sections")
}

/// ---------------------------------------------------------- academic year and term

model AcademicYear {
  id        String       @id @default(uuid()) @db.Uuid
  schoolId  String       @map("school_id") @db.Uuid
  /// e.g. "2026" or "2026-2027".
  name      String
  startDate DateTime     @map("start_date") @db.Date
  endDate   DateTime     @map("end_date") @db.Date
  status    PeriodStatus @default(UPCOMING)
  /// The year the system treats as "now". A partial unique index allows only one per
  /// school, so the current year can never be ambiguous.
  isCurrent Boolean      @default(false) @map("is_current")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  version   Int      @default(0)

  school           School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  terms            Term[]
  classSections    ClassSection[]
  enrollments      Enrollment[]
  feeStructures    FeeStructure[]
  chargeRuns       ChargeRun[]
  charges          StudentCharge[]
  discounts        Discount[]
  scholarships     StudentScholarship[]
  waivers          FeeWaiver[]
  adjustments      FinancialAdjustment[]
  financialEntries FinancialEntry[]
  payments         Payment[]

  @@unique([schoolId, name])
  @@index([schoolId, status])
  @@map("academic_years")
}

/// A term within an academic year. A first-class entity, not a label: fee structures,
/// student charges and financial reports are all scoped by term (Section 10).
///
/// The number of terms per year is school-configurable. Rwandan schools commonly use
/// three, but nothing in the schema or the code assumes that.
model Term {
  id             String       @id @default(uuid()) @db.Uuid
  schoolId       String       @map("school_id") @db.Uuid
  academicYearId String       @map("academic_year_id") @db.Uuid
  name           String
  /// Position within the year, starting at 1.
  sequence       Int
  startDate      DateTime     @map("start_date") @db.Date
  endDate        DateTime     @map("end_date") @db.Date
  status         PeriodStatus @default(UPCOMING)
  /// Only one current term per school, enforced by a partial unique index.
  isCurrent      Boolean      @default(false) @map("is_current")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  version   Int      @default(0)

  school           School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear     AcademicYear          @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  feeStructures    FeeStructure[]
  chargeRuns       ChargeRun[]
  charges          StudentCharge[]
  discounts        Discount[]
  scholarships     StudentScholarship[]
  waivers          FeeWaiver[]
  adjustments      FinancialAdjustment[]
  financialEntries FinancialEntry[]
  payments         Payment[]

  @@unique([schoolId, academicYearId, sequence])
  @@unique([schoolId, academicYearId, name])
  @@index([schoolId, status])
  @@map("terms")
}

/// ------------------------------------------------------- students and guardians

/// A student. `studentId` is the human-facing identifier used on receipts and by staff
/// (Section 7); names are never treated as unique. The identifier stays with the student
/// across years, levels and programmes.
model Student {
  id       String @id @default(uuid()) @db.Uuid
  schoolId String @map("school_id") @db.Uuid

  /// e.g. `STU-2026-00125`. Unique per school.
  studentId String @map("student_id")

  firstName   String    @map("first_name")
  lastName    String    @map("last_name")
  otherNames  String?   @map("other_names")
  gender      Gender    @default(UNDISCLOSED)
  /// Date only: a birth date has no meaningful time or zone.
  dateOfBirth DateTime? @map("date_of_birth") @db.Date

  /// Students are usually minors without identity documents; optional by design, and
  /// collected only where a school genuinely needs it (Section 24, data minimisation).
  nationalIdNumber String? @map("national_id_number")
  photoUrl         String? @map("photo_url")

  district String?
  sector   String?
  address  String?
  phone    String?
  email    String?

  admissionDate DateTime      @map("admission_date") @db.Date
  /// Year component of the Student ID, kept as a column so per-year sequences can be
  /// allocated without parsing the identifier.
  admissionYear Int           @map("admission_year")
  status        StudentStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  version   Int      @default(0)

  school           School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  guardians        StudentGuardian[]
  enrollments      Enrollment[]
  charges          StudentCharge[]
  discounts        Discount[]
  scholarships     StudentScholarship[]
  waivers          FeeWaiver[]
  adjustments      FinancialAdjustment[]
  financialAccount StudentFinancialAccount?
  financialEntries FinancialEntry[]
  payments         Payment[]

  @@unique([schoolId, studentId])
  @@index([schoolId, status])
  @@index([schoolId, lastName, firstName])
  @@index([schoolId, admissionYear])
  @@map("students")
}

/// A parent, guardian or sponsor. Separate from `User` because many guardians never get
/// a login, and one guardian may be linked to several students.
model Guardian {
  id       String  @id @default(uuid()) @db.Uuid
  schoolId String  @map("school_id") @db.Uuid
  /// Set when the guardian has a parent-portal account.
  userId   String? @unique @map("user_id") @db.Uuid

  firstName        String  @map("first_name")
  lastName         String  @map("last_name")
  /// Primary contact number: the channel most payment notifications use.
  phone            String
  altPhone         String? @map("alt_phone")
  email            String?
  nationalIdNumber String? @map("national_id_number")
  occupation       String?
  district         String?
  sector           String?
  address          String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  version   Int      @default(0)

  school   School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user     User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  students StudentGuardian[]

  @@index([schoolId])
  @@index([schoolId, phone])
  @@index([schoolId, lastName, firstName])
  @@map("guardians")
}

/// Links a guardian to a student, and carries the financial access rights that
/// Section 26 turns into authorisation checks: a parent may only see and pay for the
/// students they are explicitly linked to, with these flags.
model StudentGuardian {
  id           String               @id @default(uuid()) @db.Uuid
  schoolId     String               @map("school_id") @db.Uuid
  studentId    String               @map("student_id") @db.Uuid
  guardianId   String               @map("guardian_id") @db.Uuid
  relationship GuardianRelationship @default(GUARDIAN)

  /// First person the school contacts about this student.
  isPrimaryContact         Boolean @default(false) @map("is_primary_contact")
  /// Responsible for paying this student's fees.
  isFinanciallyResponsible Boolean @default(false) @map("is_financially_responsible")
  /// May view fees, balances, payment history and receipts.
  canViewFinancials        Boolean @default(true) @map("can_view_financials")
  /// May start a payment for this student.
  canInitiatePayments      Boolean @default(true) @map("can_initiate_payments")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  version   Int      @default(0)

  school   School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@unique([studentId, guardianId])
  @@index([schoolId])
  @@index([guardianId])
  @@map("student_guardians")
}

/// ------------------------------------------------------------------- enrolment

/// A student's placement for one academic year. Append-only: promotion, repetition,
/// completion, transfer and withdrawal all create or close an enrolment row, and no
/// historical enrolment is ever overwritten (Section 8, 22).
model Enrollment {
  id             String  @id @default(uuid()) @db.Uuid
  schoolId       String  @map("school_id") @db.Uuid
  studentId      String  @map("student_id") @db.Uuid
  academicYearId String  @map("academic_year_id") @db.Uuid
  /// Denormalised from the level so programme-level reports do not need a second join
  /// across a chain that may since have been reorganised.
  programId      String  @map("program_id") @db.Uuid
  levelId        String  @map("level_id") @db.Uuid
  classSectionId String? @map("class_section_id") @db.Uuid

  status         EnrollmentStatus @default(ENROLLED)
  enrollmentType EnrollmentType   @default(NEW)
  /// Day or boarding for this year: it changes between years and affects fees.
  residency      ResidencyType    @default(DAY)

  startDate  DateTime  @map("start_date") @db.Date
  /// Set when the enrolment ends -- year completed, transfer or withdrawal.
  endDate    DateTime? @map("end_date") @db.Date
  /// Free text recorded when a student leaves part-way through.
  exitReason String?   @map("exit_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  version   Int      @default(0)

  school       School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student      Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear    @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  program      Program         @relation(fields: [programId], references: [id], onDelete: Restrict)
  level        Level           @relation(fields: [levelId], references: [id], onDelete: Restrict)
  classSection ClassSection?   @relation(fields: [classSectionId], references: [id], onDelete: SetNull)
  charges      StudentCharge[]

  // A partial unique index in the constraints migration allows only one ENROLLED row per
  // student per year, while still permitting a withdrawal followed by a re-admission.
  @@index([schoolId, academicYearId, status])
  @@index([studentId])
  @@index([schoolId, academicYearId, levelId])
  @@index([schoolId, academicYearId, classSectionId])
  @@map("enrollments")
}

/// -------------------------------------------------------------- fees and charges

/// A kind of fee the school levies: Tuition, Boarding, Examination, Transport.
///
/// Configurable rather than an enum, because the list differs between schools and
/// changes without wanting a release. Categories are deactivated, never deleted: a
/// charge raised three years ago still names one (Section 12).
model FeeCategory {
  id          String  @id @default(uuid()) @db.Uuid
  schoolId    String  @map("school_id") @db.Uuid
  /// Short stable code, e.g. "TUITION". Used in imports and reports.
  code        String
  name        String
  description String?
  isActive    Boolean @default(true) @map("is_active")
  sortOrder   Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  version   Int      @default(0)

  school  School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  items   FeeStructureItem[]
  charges StudentCharge[]

  @@unique([schoolId, code])
  @@index([schoolId, isActive])
  @@map("fee_categories")
}

/// What the school charges, and to whom.
///
/// A structure is a *rule*, never an obligation. It carries the applicability filter —
/// year, optionally term, and optionally programme, level, class and residency — and its
/// items carry the amounts. A student matches when every field the structure specifies
/// matches their enrolment; a field left null means "does not narrow". Matching is
/// therefore additive and has no precedence rules to misread: two matching structures
/// both contribute, and generation refuses outright if they would charge the same
/// category twice (ADR-019).
///
/// `termId` is nullable. A null term is a once-per-year fee such as registration; a
/// named term is the ordinary per-term fee. The duplicate-charge key branches on this,
/// which is why two partial unique indexes exist rather than one.
model FeeStructure {
  id             String  @id @default(uuid()) @db.Uuid
  schoolId       String  @map("school_id") @db.Uuid
  name           String
  description    String?
  academicYearId String  @map("academic_year_id") @db.Uuid
  /// Null means the structure is charged once for the whole academic year.
  termId         String? @map("term_id") @db.Uuid

  /// --- applicability. Every null widens the match.
  programId      String?        @map("program_id") @db.Uuid
  levelId        String?        @map("level_id") @db.Uuid
  classSectionId String?        @map("class_section_id") @db.Uuid
  /// Restricts to boarders or to day students. Null applies to both — the reason
  /// `Enrollment.residency` exists.
  residency      ResidencyType? @map("residency")

  status FeeStructureStatus @default(DRAFT)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  version   Int      @default(0)

  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  term         Term?         @relation(fields: [termId], references: [id], onDelete: Restrict)
  program      Program?      @relation(fields: [programId], references: [id], onDelete: Restrict)
  level        Level?        @relation(fields: [levelId], references: [id], onDelete: Restrict)
  classSection ClassSection? @relation(fields: [classSectionId], references: [id], onDelete: Restrict)

  items   FeeStructureItem[]
  charges StudentCharge[]
  runs    ChargeRun[]

  @@index([schoolId, academicYearId, status])
  @@index([schoolId, termId])
  @@index([schoolId, levelId])
  @@map("fee_structures")
}

/// One line of a fee structure: a category and an amount.
///
/// At most one line per category per structure, so a single structure cannot itself
/// charge Tuition twice.
model FeeStructureItem {
  id             String  @id @default(uuid()) @db.Uuid
  schoolId       String  @map("school_id") @db.Uuid
  feeStructureId String  @map("fee_structure_id") @db.Uuid
  feeCategoryId  String  @map("fee_category_id") @db.Uuid
  /// What appears on the charge and later on the receipt. Copied onto each charge so
  /// renaming the line afterwards cannot rewrite what a parent was told they owed.
  label          String
  amount         Decimal @db.Decimal(14, 2)
  sortOrder      Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  school       School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  feeStructure FeeStructure    @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  feeCategory  FeeCategory     @relation(fields: [feeCategoryId], references: [id], onDelete: Restrict)
  charges      StudentCharge[]

  @@unique([feeStructureId, feeCategoryId])
  @@index([schoolId])
  @@map("fee_structure_items")
}

/// A bulk charge-generation run.
///
/// Kept as a row so a run is answerable after the fact: who ran it, over what scope, how
/// many charges it created and how many it skipped as already present. Charges point
/// back at it, which is what makes "why does this student have this charge?" a lookup
/// rather than an inference.
model ChargeRun {
  id             String  @id @default(uuid()) @db.Uuid
  schoolId       String  @map("school_id") @db.Uuid
  academicYearId String  @map("academic_year_id") @db.Uuid
  termId         String? @map("term_id") @db.Uuid
  /// Null when the run covered every matching structure for the period.
  feeStructureId String? @map("fee_structure_id") @db.Uuid

  status ChargeRunStatus @default(PREVIEWED)

  /// Counts as applied. A preview row is not persisted, so these describe real writes.
  studentsMatched Int     @default(0) @map("students_matched")
  chargesCreated  Int     @default(0) @map("charges_created")
  chargesSkipped  Int     @default(0) @map("charges_skipped")
  totalAmount     Decimal @default(0) @map("total_amount") @db.Decimal(14, 2)

  executedByUserId String   @map("executed_by_user_id") @db.Uuid
  executedAt       DateTime @default(now()) @map("executed_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  term         Term?         @relation(fields: [termId], references: [id], onDelete: Restrict)
  feeStructure FeeStructure? @relation(fields: [feeStructureId], references: [id], onDelete: Restrict)
  executedBy   User          @relation("ChargeRunExecutor", fields: [executedByUserId], references: [id], onDelete: Restrict)

  charges StudentCharge[]

  @@index([schoolId, academicYearId, termId])
  @@map("charge_runs")
}

/// A student's actual financial obligation.
///
/// Distinct from the fee structure that produced it, and deliberately self-contained:
/// `description` and `amount` are snapshots taken at the moment the charge was raised, so
/// a later edit to the structure — or archiving it entirely — cannot change what a
/// student was charged. `feeStructureItemId` is null for an ad-hoc charge, which is also
/// what exempts ad-hoc charges from the duplicate key.
model StudentCharge {
  id           String @id @default(uuid()) @db.Uuid
  schoolId     String @map("school_id") @db.Uuid
  studentId    String @map("student_id") @db.Uuid
  /// The enrolment the charge was raised against. Pins the charge to the student's
  /// placement *at that time*, so a later promotion cannot rewrite its academic context.
  enrollmentId String @map("enrollment_id") @db.Uuid

  academicYearId String  @map("academic_year_id") @db.Uuid
  /// Null for a once-per-year charge, mirroring the structure it came from.
  termId         String? @map("term_id") @db.Uuid

  feeCategoryId      String  @map("fee_category_id") @db.Uuid
  feeStructureId     String? @map("fee_structure_id") @db.Uuid
  feeStructureItemId String? @map("fee_structure_item_id") @db.Uuid
  chargeRunId        String? @map("charge_run_id") @db.Uuid

  /// Snapshot of the structure item's label, or the operator's description for an
  /// ad-hoc charge.
  description String
  amount      Decimal      @db.Decimal(14, 2)
  status      ChargeStatus @default(RAISED)
  /// Why an ad-hoc charge was raised. Required by the service for ad-hoc charges.
  notes       String?

  raisedByUserId String   @map("raised_by_user_id") @db.Uuid
  raisedAt       DateTime @default(now()) @map("raised_at") @db.Timestamptz(3)

  voidedByUserId String?   @map("voided_by_user_id") @db.Uuid
  voidedAt       DateTime? @map("voided_at") @db.Timestamptz(3)
  voidReason     String?   @map("void_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  version   Int      @default(0)

  school           School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student          Student           @relation(fields: [studentId], references: [id], onDelete: Restrict)
  enrollment       Enrollment        @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  academicYear     AcademicYear      @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  term             Term?             @relation(fields: [termId], references: [id], onDelete: Restrict)
  feeCategory      FeeCategory       @relation(fields: [feeCategoryId], references: [id], onDelete: Restrict)
  feeStructure     FeeStructure?     @relation(fields: [feeStructureId], references: [id], onDelete: Restrict)
  feeStructureItem FeeStructureItem? @relation(fields: [feeStructureItemId], references: [id], onDelete: Restrict)
  chargeRun        ChargeRun?        @relation(fields: [chargeRunId], references: [id], onDelete: SetNull)
  raisedBy         User              @relation("ChargeRaiser", fields: [raisedByUserId], references: [id], onDelete: Restrict)
  voidedBy         User?             @relation("ChargeVoider", fields: [voidedByUserId], references: [id], onDelete: Restrict)

  discounts    Discount[]
  scholarships StudentScholarship[]
  waivers      FeeWaiver[]
  adjustments  FinancialAdjustment[]
  entries      FinancialEntry[]

  // Duplicate protection lives in the constraints migration as two partial unique
  // indexes, because the key branches on whether the charge is termly or annual and
  // because voided charges must not block a correct re-raise.
  @@index([schoolId, studentId, academicYearId])
  @@index([schoolId, academicYearId, termId, status])
  @@index([schoolId, feeCategoryId])
  @@index([studentId, status])
  @@map("student_charges")
}

/// ------------------------------------------------- relief and adjustment records

/// A negotiated reduction: a staff-child rate, a sibling rate, an agreed settlement.
///
/// A *business record*, not a balance. It never modifies the charge it applies to, and
/// it moves nothing until approved — approval posts a CREDIT `FinancialEntry`, and that
/// entry is what the balance is computed from (ADR-022).
model Discount {
  id              String  @id @default(uuid()) @db.Uuid
  schoolId        String  @map("school_id") @db.Uuid
  studentId       String  @map("student_id") @db.Uuid
  /// Null for a discount that applies across a period rather than to one charge.
  studentChargeId String? @map("student_charge_id") @db.Uuid

  academicYearId String  @map("academic_year_id") @db.Uuid
  termId         String? @map("term_id") @db.Uuid

  method     AdjustmentMethod @default(FIXED)
  /// Set only for PERCENTAGE, so a rate can be explained and re-checked.
  percentage Decimal?         @db.Decimal(5, 2)
  /// The resolved amount, always positive. Frozen at request, re-checked at approval.
  amount     Decimal          @db.Decimal(14, 2)

  reason String
  status ApprovalStatus @default(PENDING_APPROVAL)

  requestedByUserId String    @map("requested_by_user_id") @db.Uuid
  requestedAt       DateTime  @default(now()) @map("requested_at") @db.Timestamptz(3)
  decidedByUserId   String?   @map("decided_by_user_id") @db.Uuid
  decidedAt         DateTime? @map("decided_at") @db.Timestamptz(3)
  decisionNote      String?   @map("decision_note")
  reversedByUserId  String?   @map("reversed_by_user_id") @db.Uuid
  reversedAt        DateTime? @map("reversed_at") @db.Timestamptz(3)
  reversalReason    String?   @map("reversal_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  version   Int      @default(0)

  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student       Student        @relation(fields: [studentId], references: [id], onDelete: Restrict)
  studentCharge StudentCharge? @relation(fields: [studentChargeId], references: [id], onDelete: Restrict)
  academicYear  AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  term          Term?          @relation(fields: [termId], references: [id], onDelete: Restrict)
  requestedBy   User           @relation("DiscountRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  decidedBy     User?          @relation("DiscountApprover", fields: [decidedByUserId], references: [id], onDelete: Restrict)
  reversedBy    User?          @relation("DiscountReverser", fields: [reversedByUserId], references: [id], onDelete: Restrict)

  entries FinancialEntry[]

  @@index([schoolId, studentId, status])
  @@index([schoolId, academicYearId, termId, status])
  @@index([studentChargeId])
  @@map("discounts")
}

/// A named award programme: "Girls in STEM Bursary", "District Merit Scholarship".
///
/// The programme, not the money. It carries the terms on which awards are normally made;
/// what an individual student actually receives is a `StudentScholarship`. Separating
/// them is what lets a school answer "how much did this bursary cost us this year?"
/// without reading every award's free text.
model Scholarship {
  id          String  @id @default(uuid()) @db.Uuid
  schoolId    String  @map("school_id") @db.Uuid
  code        String
  name        String
  description String?
  /// Who funds it. Plain text: a sponsor is not a system entity.
  sponsor     String?

  /// Defaults offered when awarding. An award may differ, and stores its own figures.
  defaultMethod     AdjustmentMethod @default(FIXED) @map("default_method")
  defaultPercentage Decimal?         @map("default_percentage") @db.Decimal(5, 2)
  defaultAmount     Decimal?         @map("default_amount") @db.Decimal(14, 2)

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  version   Int      @default(0)

  school School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  awards StudentScholarship[]

  @@unique([schoolId, code])
  @@index([schoolId, isActive])
  @@map("scholarships")
}

/// One student's award under a scholarship, for one academic period.
///
/// Per-period by design. A scholarship is not assumed to be permanent (Section 15): each
/// year or term a student benefits is its own approved record, so withdrawing an award
/// next year changes nothing about the year it did apply to, and nothing renews silently.
model StudentScholarship {
  id              String  @id @default(uuid()) @db.Uuid
  schoolId        String  @map("school_id") @db.Uuid
  scholarshipId   String  @map("scholarship_id") @db.Uuid
  studentId       String  @map("student_id") @db.Uuid
  /// Null for an award covering a whole period rather than one charge.
  studentChargeId String? @map("student_charge_id") @db.Uuid

  academicYearId String  @map("academic_year_id") @db.Uuid
  termId         String? @map("term_id") @db.Uuid

  method     AdjustmentMethod @default(FIXED)
  percentage Decimal?         @db.Decimal(5, 2)
  amount     Decimal          @db.Decimal(14, 2)

  reason String
  status ApprovalStatus @default(PENDING_APPROVAL)

  requestedByUserId String    @map("requested_by_user_id") @db.Uuid
  requestedAt       DateTime  @default(now()) @map("requested_at") @db.Timestamptz(3)
  decidedByUserId   String?   @map("decided_by_user_id") @db.Uuid
  decidedAt         DateTime? @map("decided_at") @db.Timestamptz(3)
  decisionNote      String?   @map("decision_note")
  reversedByUserId  String?   @map("reversed_by_user_id") @db.Uuid
  reversedAt        DateTime? @map("reversed_at") @db.Timestamptz(3)
  reversalReason    String?   @map("reversal_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  version   Int      @default(0)

  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  scholarship   Scholarship    @relation(fields: [scholarshipId], references: [id], onDelete: Restrict)
  student       Student        @relation(fields: [studentId], references: [id], onDelete: Restrict)
  studentCharge StudentCharge? @relation(fields: [studentChargeId], references: [id], onDelete: Restrict)
  academicYear  AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  term          Term?          @relation(fields: [termId], references: [id], onDelete: Restrict)
  requestedBy   User           @relation("ScholarshipRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  decidedBy     User?          @relation("ScholarshipApprover", fields: [decidedByUserId], references: [id], onDelete: Restrict)
  reversedBy    User?          @relation("ScholarshipReverser", fields: [reversedByUserId], references: [id], onDelete: Restrict)

  entries FinancialEntry[]

  @@index([schoolId, studentId, status])
  @@index([schoolId, scholarshipId, academicYearId])
  @@index([studentChargeId])
  @@map("student_scholarships")
}

/// An authorised write-off: an amount the school has decided not to pursue.
///
/// Distinct from a discount (which is agreed before the fact), from a payment (no money
/// arrived) and from a correction (the charge was right). Always fixed — a waiver is a
/// decision about a specific sum, not a rate.
model FeeWaiver {
  id              String  @id @default(uuid()) @db.Uuid
  schoolId        String  @map("school_id") @db.Uuid
  studentId       String  @map("student_id") @db.Uuid
  studentChargeId String? @map("student_charge_id") @db.Uuid

  academicYearId String  @map("academic_year_id") @db.Uuid
  termId         String? @map("term_id") @db.Uuid

  amount Decimal        @db.Decimal(14, 2)
  reason String
  status ApprovalStatus @default(PENDING_APPROVAL)

  requestedByUserId String    @map("requested_by_user_id") @db.Uuid
  requestedAt       DateTime  @default(now()) @map("requested_at") @db.Timestamptz(3)
  decidedByUserId   String?   @map("decided_by_user_id") @db.Uuid
  decidedAt         DateTime? @map("decided_at") @db.Timestamptz(3)
  decisionNote      String?   @map("decision_note")
  reversedByUserId  String?   @map("reversed_by_user_id") @db.Uuid
  reversedAt        DateTime? @map("reversed_at") @db.Timestamptz(3)
  reversalReason    String?   @map("reversal_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  version   Int      @default(0)

  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student       Student        @relation(fields: [studentId], references: [id], onDelete: Restrict)
  studentCharge StudentCharge? @relation(fields: [studentChargeId], references: [id], onDelete: Restrict)
  academicYear  AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  term          Term?          @relation(fields: [termId], references: [id], onDelete: Restrict)
  requestedBy   User           @relation("WaiverRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  decidedBy     User?          @relation("WaiverApprover", fields: [decidedByUserId], references: [id], onDelete: Restrict)
  reversedBy    User?          @relation("WaiverReverser", fields: [reversedByUserId], references: [id], onDelete: Restrict)

  entries FinancialEntry[]

  @@index([schoolId, studentId, status])
  @@index([schoolId, academicYearId, termId, status])
  @@index([studentChargeId])
  @@map("fee_waivers")
}

/// An authorised administrative correction, in either direction.
///
/// This is how a mistake is fixed: the wrong figure is never edited, a correcting record
/// is raised against it and, on approval, an opposing ledger entry is posted (Section
/// 17). `direction` is explicit because a correction can legitimately go either way — an
/// overcharge is credited back, a late fee is debited.
model FinancialAdjustment {
  id              String  @id @default(uuid()) @db.Uuid
  schoolId        String  @map("school_id") @db.Uuid
  studentId       String  @map("student_id") @db.Uuid
  studentChargeId String? @map("student_charge_id") @db.Uuid

  academicYearId String  @map("academic_year_id") @db.Uuid
  termId         String? @map("term_id") @db.Uuid

  direction EntryDirection
  amount    Decimal        @db.Decimal(14, 2)

  reason String
  status ApprovalStatus @default(PENDING_APPROVAL)

  requestedByUserId String    @map("requested_by_user_id") @db.Uuid
  requestedAt       DateTime  @default(now()) @map("requested_at") @db.Timestamptz(3)
  decidedByUserId   String?   @map("decided_by_user_id") @db.Uuid
  decidedAt         DateTime? @map("decided_at") @db.Timestamptz(3)
  decisionNote      String?   @map("decision_note")
  reversedByUserId  String?   @map("reversed_by_user_id") @db.Uuid
  reversedAt        DateTime? @map("reversed_at") @db.Timestamptz(3)
  reversalReason    String?   @map("reversal_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  version   Int      @default(0)

  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student       Student        @relation(fields: [studentId], references: [id], onDelete: Restrict)
  studentCharge StudentCharge? @relation(fields: [studentChargeId], references: [id], onDelete: Restrict)
  academicYear  AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  term          Term?          @relation(fields: [termId], references: [id], onDelete: Restrict)
  requestedBy   User           @relation("AdjustmentRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  decidedBy     User?          @relation("AdjustmentApprover", fields: [decidedByUserId], references: [id], onDelete: Restrict)
  reversedBy    User?          @relation("AdjustmentReverser", fields: [reversedByUserId], references: [id], onDelete: Restrict)

  entries FinancialEntry[]

  @@index([schoolId, studentId, status])
  @@index([schoolId, academicYearId, termId, status])
  @@index([studentChargeId])
  @@map("financial_adjustments")
}

/// ------------------------------------------------------- the financial ledger

/// A student's financial account: the thing the ledger rolls up to.
///
/// Carries **no balance column**. A balance is the sum of this account's entries,
/// computed on every read (ADR-021). There is deliberately nothing here for a bug, a
/// bulk script or a well-meaning migration to set to the wrong number.
///
/// One per student, created on demand the first time anything financial happens to them.
model StudentFinancialAccount {
  id        String @id @default(uuid()) @db.Uuid
  schoolId  String @map("school_id") @db.Uuid
  studentId String @unique @map("student_id") @db.Uuid

  /// ISO-4217, copied from school settings when the account opens. Held here so a
  /// school changing currency later cannot silently reinterpret existing history.
  currency String                 @default("RWF") @db.VarChar(3)
  status   FinancialAccountStatus @default(ACTIVE)

  openedAt  DateTime  @default(now()) @map("opened_at") @db.Timestamptz(3)
  closedAt  DateTime? @map("closed_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  version   Int       @default(0)

  school   School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student  Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  entries  FinancialEntry[]
  payments Payment[]

  @@index([schoolId, status])
  @@map("student_financial_accounts")
}

/// The authoritative financial ledger. One row per movement, insert-only.
///
/// **This is what a balance is computed from.** Charges, discounts, scholarships, waivers
/// and adjustments are business records that justify entries; none of them is summed to
/// produce a balance, which is what makes double-counting structurally impossible rather
/// than a rule someone has to remember (ADR-022).
///
///     balance = Σ DEBIT − Σ CREDIT
///
/// Insert-only in the strict sense: there is no status column and no update path. An
/// entry that turns out to be wrong is not edited or deleted — an opposing entry is
/// posted and linked through `reversalOfEntryId`, so the ledger records that something
/// was undone as well as that it happened (Section 20). Phase 11 revokes UPDATE and
/// DELETE on this table from the application role.
///
/// Phase 5 adds payments as `source = PAYMENT` CREDIT entries. Nothing about the balance
/// formula changes when it does; that is the point of the shape.
model FinancialEntry {
  id        String @id @default(uuid()) @db.Uuid
  schoolId  String @map("school_id") @db.Uuid
  accountId String @map("account_id") @db.Uuid
  /// Denormalised from the account so the common query — one student's ledger — does
  /// not need a join, and so a per-student index is possible.
  studentId String @map("student_id") @db.Uuid

  academicYearId String  @map("academic_year_id") @db.Uuid
  termId         String? @map("term_id") @db.Uuid

  entryType EntryDirection       @map("entry_type")
  /// Always positive. Direction is `entryType`, never the sign.
  amount    Decimal              @db.Decimal(14, 2)
  source    FinancialEntrySource

  /// Exactly one of these is set, matching `source`. Enforced by a check constraint.
  studentChargeId       String? @map("student_charge_id") @db.Uuid
  discountId            String? @map("discount_id") @db.Uuid
  studentScholarshipId  String? @map("student_scholarship_id") @db.Uuid
  feeWaiverId           String? @map("fee_waiver_id") @db.Uuid
  financialAdjustmentId String? @map("financial_adjustment_id") @db.Uuid
  /// Phase 5. Set on a PAYMENT entry — the credit a verified payment posted, or the
  /// compensating debit that undid it. A partial unique index permits exactly one
  /// opening credit per payment, which is what makes a duplicate callback structurally
  /// incapable of crediting twice rather than merely unlikely to.
  paymentId             String? @map("payment_id") @db.Uuid

  /// What this line says on a statement.
  description String

  /// Set when this entry undoes an earlier one. The earlier entry is left untouched.
  reversalOfEntryId String? @unique @map("reversal_of_entry_id") @db.Uuid

  postedByUserId String   @map("posted_by_user_id") @db.Uuid
  postedAt       DateTime @default(now()) @map("posted_at") @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  school              School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  account             StudentFinancialAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  student             Student                 @relation(fields: [studentId], references: [id], onDelete: Restrict)
  academicYear        AcademicYear            @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  term                Term?                   @relation(fields: [termId], references: [id], onDelete: Restrict)
  studentCharge       StudentCharge?          @relation(fields: [studentChargeId], references: [id], onDelete: Restrict)
  discount            Discount?               @relation(fields: [discountId], references: [id], onDelete: Restrict)
  studentScholarship  StudentScholarship?     @relation(fields: [studentScholarshipId], references: [id], onDelete: Restrict)
  feeWaiver           FeeWaiver?              @relation(fields: [feeWaiverId], references: [id], onDelete: Restrict)
  financialAdjustment FinancialAdjustment?    @relation(fields: [financialAdjustmentId], references: [id], onDelete: Restrict)
  payment             Payment?                @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  postedBy            User                    @relation("EntryPoster", fields: [postedByUserId], references: [id], onDelete: Restrict)
  reversalOf          FinancialEntry?         @relation("EntryReversal", fields: [reversalOfEntryId], references: [id], onDelete: Restrict)
  reversedBy          FinancialEntry?         @relation("EntryReversal")

  @@index([schoolId, studentId, academicYearId, termId])
  @@index([accountId, postedAt])
  @@index([schoolId, source, postedAt])
  @@index([studentChargeId])
  // "Which ledger lines belong to this payment?" — asked by the payment detail screen
  // for every payment it shows, and by a reversal before it posts.
  @@index([paymentId])
  @@map("financial_entries")
}

/// ------------------------------------------------------------------- payments

/// A payment: one attempt by one payer to settle part of what one student owes.
///
/// **Carries no ledger effect of its own.** A payment is a business record, exactly like
/// a charge or a discount; what it does to a balance is the `FinancialEntry` it posts on
/// verification, and nothing else (ADR-022). A payment stuck in PENDING has moved no
/// money, and no screen adds a payment row into a total.
///
/// The three things this table is shaped to make impossible:
///
///  - **Crediting twice.** `payment_id` on `financial_entries` carries a partial unique
///    index permitting one opening credit per payment. A duplicate callback, a retried
///    request and two concurrent finalisers all collide on it.
///  - **Creating twice.** `(school_id, idempotency_key)` is unique, so a retried
///    initiation returns the payment it already made rather than making another. The
///    fingerprint alongside it is what distinguishes an honest retry from the same key
///    being reused for a different request.
///  - **Editing history.** Verification, reversal and refund each add columns and a
///    status-history row. The amount, the payer and the period are never rewritten.
model Payment {
  id        String @id @default(uuid()) @db.Uuid
  schoolId  String @map("school_id") @db.Uuid
  studentId String @map("student_id") @db.Uuid
  /// The account the credit will be posted to. Resolved and pinned at initiation so a
  /// payment cannot be verified into a different account than it was accepted for.
  accountId String @map("account_id") @db.Uuid

  /// The period the credit belongs to. A ledger entry must name a year, so a payment
  /// must too; the term is optional for a fee charged once per year.
  academicYearId String  @map("academic_year_id") @db.Uuid
  termId         String? @map("term_id") @db.Uuid

  /// e.g. `PAY-2026-000001234`. Allocated from the per-year counter, because this is
  /// what a parent reads out over the phone and what reconciliation joins on.
  reference String

  /// Always positive, always in `currency`, which must match the account's.
  amount   Decimal @db.Decimal(14, 2)
  currency String  @db.VarChar(3)

  method             PaymentMethod
  verificationMethod PaymentVerificationMethod @map("verification_method")
  status             PaymentStatus             @default(PENDING)
  /// Null for cash handed over at the bursar's office, which has no provider.
  providerKey        PaymentProviderKey?       @map("provider_key")

  /// Who paid. Recorded because the person paying is frequently not the account holder
  /// and a bursar matching a statement line needs the name that appears on it.
  payerName         String  @map("payer_name")
  payerPhone        String? @map("payer_phone")
  payerEmail        String? @map("payer_email")
  /// The bank or wallet reference the payer quotes, or the provider returns. Not unique:
  /// a payer can mistype one, and refusing the claim outright would lose the evidence.
  externalReference String? @map("external_reference")

  /// Client-supplied key making initiation safe to retry (Section 14).
  idempotencyKey         String? @map("idempotency_key")
  /// Digest of the request the key was first used for. A second request with the same
  /// key but a different student, amount or method is a bug or an attack, not a retry,
  /// and is refused rather than silently answered with the wrong payment.
  idempotencyFingerprint String? @map("idempotency_fingerprint")

  notes         String?
  /// Why it failed, in words safe to show the payer. Never a provider stack trace.
  failureReason String? @map("failure_reason")

  initiatedByUserId String    @map("initiated_by_user_id") @db.Uuid
  initiatedAt       DateTime  @default(now()) @map("initiated_at") @db.Timestamptz(3)
  /// Set when the payment reached a terminal outcome, successful or not.
  completedAt       DateTime? @map("completed_at") @db.Timestamptz(3)

  /// --- verification. A check constraint requires all three on a SUCCESSFUL payment, so
  /// a credited payment can never be missing the person who authorised it.
  verifiedByUserId String?   @map("verified_by_user_id") @db.Uuid
  verifiedAt       DateTime? @map("verified_at") @db.Timestamptz(3)
  verificationNote String?   @map("verification_note")

  /// --- reversal and refund. The original is preserved; these record the second fact.
  reversedByUserId String?   @map("reversed_by_user_id") @db.Uuid
  reversedAt       DateTime? @map("reversed_at") @db.Timestamptz(3)
  reversalReason   String?   @map("reversal_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  version   Int      @default(0)

  school       School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student      Student                 @relation(fields: [studentId], references: [id], onDelete: Restrict)
  account      StudentFinancialAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  academicYear AcademicYear            @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  term         Term?                   @relation(fields: [termId], references: [id], onDelete: Restrict)
  initiatedBy  User                    @relation("PaymentInitiator", fields: [initiatedByUserId], references: [id], onDelete: Restrict)
  verifiedBy   User?                   @relation("PaymentVerifier", fields: [verifiedByUserId], references: [id], onDelete: Restrict)
  reversedBy   User?                   @relation("PaymentReverser", fields: [reversedByUserId], references: [id], onDelete: Restrict)

  transactions   PaymentTransaction[]
  statusHistory  PaymentStatusHistory[]
  evidence       PaymentEvidence[]
  webhookEvents  PaymentWebhookEvent[]
  /// The statement line this payment was reconciled against, once one is matched to it.
  statementLines BankStatementLine[]
  /// The ledger lines this payment produced: its credit, and any compensating entry.
  entries        FinancialEntry[]

  @@unique([schoolId, reference])
  // Idempotency, enforced by the database rather than by a check the application runs
  // and then hopes still holds. NULLs are distinct in PostgreSQL, so payments recorded
  // without a key — a bursar taking cash at the desk — are unaffected.
  @@unique([schoolId, idempotencyKey])
  // The payments table: filtered by status, ordered by when it happened.
  @@index([schoolId, status, initiatedAt])
  // One student's payment history, which is the parent portal's main read.
  @@index([schoolId, studentId, initiatedAt])
  // The pending manual-verification queue: the bursar's daily worklist.
  @@index([schoolId, verificationMethod, status, initiatedAt])
  @@index([accountId])
  @@map("payments")
}

/// One attempt against a payment provider.
///
/// Separate from `Payment` because the relationship is genuinely one-to-many: a payer
/// whose first mobile-money prompt timed out tries again, and both attempts are facts
/// worth keeping — the first may still settle later, which is the case that turns into a
/// duplicate credit if the attempts are collapsed into one row that gets overwritten.
///
/// `(provider_key, provider_transaction_id)` is unique, which is the database-level
/// rejection of the same provider transaction being recorded against two payments.
model PaymentTransaction {
  id        String @id @default(uuid()) @db.Uuid
  schoolId  String @map("school_id") @db.Uuid
  paymentId String @map("payment_id") @db.Uuid

  providerKey PaymentProviderKey @map("provider_key")

  /// The reference the school sends the provider, and the one a callback must quote back.
  /// Unique per school so an inbound callback resolves to exactly one attempt.
  internalReference     String  @map("internal_reference")
  /// The provider's own identifier. Null until it gives one — a request that timed out
  /// before any response has no provider id and must not be assumed to have failed.
  providerTransactionId String? @map("provider_transaction_id")

  requestedAmount Decimal  @map("requested_amount") @db.Decimal(14, 2)
  /// What the provider says was actually taken. Compared against the payment amount
  /// before anything is credited; a mismatch parks the payment for review rather than
  /// crediting the smaller or larger figure (Section 20).
  confirmedAmount Decimal? @map("confirmed_amount") @db.Decimal(14, 2)
  currency        String   @db.VarChar(3)

  status PaymentTransactionStatus @default(INITIATED)

  failureCode      String? @map("failure_code")
  failureMessage   String? @map("failure_message")
  /// A deliberately small, provider-specific subset: status codes, references and
  /// timestamps. Never credentials, tokens, signatures or a full callback body
  /// (Section 38).
  providerMetadata Json?   @map("provider_metadata")

  initiatedAt DateTime  @default(now()) @map("initiated_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  webhookEvents PaymentWebhookEvent[]

  @@unique([schoolId, internalReference])
  @@unique([providerKey, providerTransactionId])
  @@index([paymentId, initiatedAt])
  @@index([schoolId, status, initiatedAt])
  @@map("payment_transactions")
}

/// Every meaningful status transition a payment went through. Insert-only.
///
/// Kept as rows rather than inferred from the timestamps on `payments`, because the
/// question a reviewer asks months later is "how did this get here?" — and a column
/// holding the current status cannot answer it. A payment that went
/// PENDING → REQUIRES_REVIEW → SUCCESSFUL looks identical to one verified first time
/// unless the intermediate step was written down.
model PaymentStatusHistory {
  id        String @id @default(uuid()) @db.Uuid
  schoolId  String @map("school_id") @db.Uuid
  paymentId String @map("payment_id") @db.Uuid

  /// Null on the row recording the payment's creation.
  fromStatus PaymentStatus? @map("from_status")
  toStatus   PaymentStatus  @map("to_status")

  source PaymentStatusChangeSource
  reason String?

  /// Null when the provider or the system caused the change rather than a person.
  actorUserId String? @map("actor_user_id") @db.Uuid
  metadata    Json?

  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  actor   User?   @relation("PaymentStatusActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([paymentId, occurredAt])
  @@index([schoolId, toStatus, occurredAt])
  @@map("payment_status_history")
}

/// Proof of payment attached to a manual claim.
///
/// Insert-only, like everything else that justifies money moving. Replacing a slip does
/// not overwrite the old row: the new one is inserted and the old is marked superseded,
/// so "the evidence changed after the bursar looked at it" is visible rather than
/// invisible (Section 23).
///
/// The file itself lives outside the database and outside any web-servable path, keyed by
/// `storageKey`. It is only ever served through an authenticated endpoint, so there is no
/// URL to forward to someone who may not see it.
model PaymentEvidence {
  id        String              @id @default(uuid()) @db.Uuid
  schoolId  String              @map("school_id") @db.Uuid
  paymentId String              @map("payment_id") @db.Uuid
  kind      PaymentEvidenceKind

  /// Opaque, server-generated storage path. Never derived from the uploaded filename,
  /// which is attacker-controlled and would otherwise allow path traversal.
  storageKey  String @map("storage_key")
  /// What the uploader called it. Shown to a reviewer, never used as a path.
  fileName    String @map("file_name")
  /// Determined from the file's own magic bytes, not from the browser's Content-Type.
  contentType String @map("content_type")
  byteSize    Int    @map("byte_size")
  /// SHA-256 of the bytes. Lets a reviewer tell a re-uploaded duplicate from a
  /// genuinely different document, and lets an auditor prove the file is unchanged.
  checksum    String

  /// Whether the bytes were scanned for malicious content. `SKIPPED` is the honest value
  /// when no scanner is configured, and it is recorded rather than assumed: a reviewer
  /// must be able to tell an unscanned file from a clean one. See docs/SECURITY.md.
  scanState ContentScanState @default(SKIPPED) @map("scan_state")

  uploadedByUserId String   @map("uploaded_by_user_id") @db.Uuid
  uploadedAt       DateTime @default(now()) @map("uploaded_at") @db.Timestamptz(3)

  /// False once a later upload of the same kind replaced it. Superseded rows are kept.
  isCurrent Boolean @default(true) @map("is_current")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  school     School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  payment    Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation("EvidenceUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)

  @@unique([storageKey])
  @@index([paymentId, uploadedAt])
  @@index([schoolId, scanState])
  @@map("payment_evidence")
}

/// Every inbound provider callback, verified or not. Insert-only.
///
/// Written **before** the callback is acted on, which is what makes webhook processing
/// idempotent: `(provider_key, event_id)` is unique, so a re-delivered callback loses the
/// insert and is answered from the record of the first delivery instead of being
/// processed again. Combined with the one-credit-per-payment index, a provider retrying
/// ten times produces one credit.
///
/// Rejected callbacks are recorded too. A single bad signature is a misconfiguration; a
/// stream of them is someone forging callbacks, and that distinction only exists if the
/// failures were written down (Section 16).
model PaymentWebhookEvent {
  id       String  @id @default(uuid()) @db.Uuid
  /// Null when the callback could not be attributed to a school — an unknown reference,
  /// or a body that failed verification before anything was parsed.
  schoolId String? @map("school_id") @db.Uuid

  providerKey PaymentProviderKey @map("provider_key")
  /// The provider's delivery identifier, or the payload digest when it sends none. Never
  /// null, so the uniqueness guarantee holds for every provider.
  eventId     String             @map("event_id")

  paymentId            String? @map("payment_id") @db.Uuid
  paymentTransactionId String? @map("payment_transaction_id") @db.Uuid

  verification  WebhookVerificationResult
  /// The timestamp the provider signed, used to refuse a replayed capture.
  signedAt      DateTime?                 @map("signed_at") @db.Timestamptz(3)
  /// SHA-256 of the raw request body. Lets an investigation prove exactly what was
  /// received without storing a payload that may carry payer detail or provider tokens.
  payloadDigest String                    @map("payload_digest")
  /// A small, deliberately chosen subset of the callback: its event type, the reference
  /// it named, the amount and the status. Never the raw body (Sections 22, 38).
  safeMetadata  Json?                     @map("safe_metadata")

  /// The status the payment was moved to as a result, if any.
  resultingStatus PaymentStatus? @map("resulting_status")
  /// Correlates with the API access log and the audit entry.
  requestId       String?        @map("request_id")

  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(3)

  school             School?             @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  payment            Payment?            @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  paymentTransaction PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id], onDelete: SetNull)

  @@unique([providerKey, eventId])
  @@index([schoolId, receivedAt])
  @@index([providerKey, verification, receivedAt])
  @@index([paymentId])
  @@map("payment_webhook_events")
}

/// --------------------------------------------------- reconciliation (Phase 5)

/// Which way the money went on a bank statement line.
///
/// Deliberately its own enum rather than a reuse of `EntryDirection`. A DEBIT on a
/// student's account and a debit on the school's bank account are opposite things, and a
/// shared enum would make the two readings indistinguishable in code that has to reconcile
/// one against the other.
enum BankStatementDirection {
  /// Money arrived in the school's account. These are the lines a payment can match.
  MONEY_IN
  /// Money left it: a bank charge, a reversal, a transfer out. Never matched to a
  /// payment, but imported so the statement reconciles to its own total.
  MONEY_OUT

  @@map("bank_statement_direction")
}

/// What has been decided about one statement line.
enum StatementLineMatchStatus {
  /// Nobody has attributed it yet. The bursar's worklist.
  UNMATCHED
  /// Attributed to exactly one payment.
  MATCHED
  /// Deliberately set aside, with a reason: a bank charge, a transfer between the
  /// school's own accounts, a duplicate line in the export.
  IGNORED
  /// More than one payment could be the one. Parked for a person rather than guessed,
  /// because guessing means crediting the wrong family (Section 20).
  AMBIGUOUS

  @@map("statement_line_match_status")
}

/// One uploaded bank or remittance statement.
///
/// The file itself is parsed and discarded; what is kept is its rows, its checksum and who
/// imported it. The checksum is unique per school, which is what stops the same export
/// being imported twice and doubling every line a bursar then has to work through.
model BankStatementImport {
  id       String             @id @default(uuid()) @db.Uuid
  schoolId String             @map("school_id") @db.Uuid
  /// Which institution the statement came from, so a line is matched against payments
  /// that claim to have gone through the same one.
  provider PaymentProviderKey

  /// What the bank calls the account. Free text: every bank formats it differently, and
  /// it is shown to a bursar rather than parsed.
  accountLabel String? @map("account_label")

  fileName String @map("file_name")
  /// SHA-256 of the uploaded bytes. Unique per school: the same file is not imported
  /// twice, and a re-export with one new line is a different file.
  checksum String

  /// The range the rows actually cover, derived from them rather than typed by the
  /// uploader — a statement's own dates are more trustworthy than a person's memory.
  periodStart DateTime? @map("period_start") @db.Date
  periodEnd   DateTime? @map("period_end") @db.Date

  lineCount Int     @map("line_count")
  /// Sum of the MONEY_IN lines, as imported. Kept because it is a property of the file —
  /// a figure to reconcile *against*, not a derived balance that could drift.
  totalIn   Decimal @map("total_in") @db.Decimal(14, 2)
  totalOut  Decimal @map("total_out") @db.Decimal(14, 2)
  currency  String  @db.VarChar(3)

  importedByUserId String   @map("imported_by_user_id") @db.Uuid
  importedAt       DateTime @default(now()) @map("imported_at") @db.Timestamptz(3)
  notes            String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  school     School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  importedBy User                @relation("StatementImporter", fields: [importedByUserId], references: [id], onDelete: Restrict)
  lines      BankStatementLine[]

  @@unique([schoolId, checksum])
  @@index([schoolId, importedAt])
  @@map("bank_statement_imports")
}

/// One line from a statement. Insert-only; matching updates the decision, never the line.
///
/// The amount, date and narrative are exactly what the bank said. They are never edited
/// to make a match work: a line that does not fit a payment is a question about the
/// payment, not a typo to correct (Section 20).
model BankStatementLine {
  id       String @id @default(uuid()) @db.Uuid
  schoolId String @map("school_id") @db.Uuid
  importId String @map("import_id") @db.Uuid

  /// 1-based, counting the header, so it matches the row the bursar sees in the file.
  lineNumber Int      @map("line_number")
  valueDate  DateTime @map("value_date") @db.Date
  /// The bank's own description. Where an automatic match finds its reference.
  narrative  String
  /// A reference column, where the bank provides one separately.
  reference  String?

  amount    Decimal                @db.Decimal(14, 2)
  currency  String                 @db.VarChar(3)
  direction BankStatementDirection

  matchStatus      StatementLineMatchStatus @default(UNMATCHED) @map("match_status")
  /// The payment this line is attributed to. A partial unique index enforces one line per
  /// payment: two statement lines claiming the same payment would mean the school had
  /// been paid twice and noticed once.
  matchedPaymentId String?                  @map("matched_payment_id") @db.Uuid
  /// Null when the automatic pass matched it, which is why it is separate from `matchedAt`.
  matchedByUserId  String?                  @map("matched_by_user_id") @db.Uuid
  matchedAt        DateTime?                @map("matched_at") @db.Timestamptz(3)
  /// Why a line was ignored, or what a person saw when they matched it. Required to
  /// ignore, because "not ours" without a reason is indistinguishable from carelessness.
  matchNote        String?                  @map("match_note")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  version   Int      @default(0)

  school         School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  import         BankStatementImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  matchedPayment Payment?            @relation(fields: [matchedPaymentId], references: [id], onDelete: SetNull)
  matchedBy      User?               @relation("StatementMatcher", fields: [matchedByUserId], references: [id], onDelete: SetNull)

  @@unique([importId, lineNumber])
  // The reconciliation worklist: unmatched money-in lines, oldest first.
  @@index([schoolId, matchStatus, valueDate])
  @@index([importId, lineNumber])
  @@index([matchedPaymentId])
  @@map("bank_statement_lines")
}

/// ------------------------------------------------------------------- audit trail

/// Insert-only record of every consequential action (Section 27).
///
/// Written from Phase 2 onward. UPDATE and DELETE are revoked from the application role
/// in Phase 11, and `previousHash`/`hash` then chain the entries so out-of-band
/// tampering is detectable. The columns exist now so that hardening is a migration on an
/// existing shape rather than a redesign.
model AuditLog {
  id       String  @id @default(uuid()) @db.Uuid
  /// Null for actions outside any school, such as a Super Administrator sign-in.
  schoolId String? @map("school_id") @db.Uuid

  /// Null for an action by an unauthenticated caller, e.g. a failed sign-in.
  actorUserId  String? @map("actor_user_id") @db.Uuid
  /// Captured at the time of the action, because a user's roles can change later.
  actorRoleKey String? @map("actor_role_key")

  /// Dotted verb, e.g. `payment.manual_claim.verified`.
  action     String
  entityType String  @map("entity_type")
  entityId   String? @map("entity_id")

  result AuditResult @default(SUCCESS)
  /// Why a FAILURE happened, or extra context for a success. Never secrets.
  reason String?

  /// Correlates with the API response and the access log.
  requestId String? @map("request_id")
  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")

  /// State before and after, for financial changes. Personal data is included only where
  /// it is the subject of the change, and the retention policy applies to it.
  beforeState Json? @map("before_state")
  afterState  Json? @map("after_state")
  metadata    Json?

  /// Hash chain, populated from Phase 11.
  previousHash String? @map("previous_hash")
  hash         String?

  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  school    School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  actorUser User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([schoolId, occurredAt])
  @@index([schoolId, entityType, entityId])
  @@index([actorUserId, occurredAt])
  @@index([action, occurredAt])
  @@map("audit_logs")
}
