# School Finance System -- backend environment template.
#
# Copy to `.env` for local development:  cp backend/.env.example backend/.env
# NEVER commit a real `.env`. Every variable is documented in docs/ENVIRONMENT.md.

# ----------------------------------------------------------------- runtime
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
APP_VERSION=0.1.0

# ----------------------------------------------------------------- logging
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
# Human-readable logs locally; leave unset (JSON) in production.
LOG_PRETTY=true

# ---------------------------------------------------------------- database
# Matches the credentials and port in docker-compose.yml. Start it with: npm run db:up
# Port 5544, not 5432, so the container does not clash with an existing local PostgreSQL.
DATABASE_URL=postgresql://sfs:sfs_local_dev_password@localhost:5544/school_finance?schema=public

# Separate database used by integration tests; a test run truncates it.
TEST_DATABASE_URL=postgresql://sfs:sfs_local_dev_password@localhost:5544/school_finance_test?schema=public

# ---------------------------------------------------------------- security
# Exact origins allowed to call the API, comma-separated. No wildcards in production.
CORS_ORIGINS=http://localhost:5173

# Global rate limit per IP.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300

# Maximum accepted JSON body size.
JSON_BODY_LIMIT=256kb

# Number of reverse proxies in front of the API. 0 when running directly.
# Set this correctly in production, or X-Forwarded-For can be forged to evade rate limits.
TRUST_PROXY_HOPS=0

# Seconds allowed for in-flight requests to finish during shutdown.
SHUTDOWN_TIMEOUT_SECONDS=15
