# School Finance System -- backend environment template.
#
# Copy to `.env` for local development:  cp backend/.env.example backend/.env
# NEVER commit a real `.env`. Every variable is documented in docs/ENVIRONMENT.md.

# ----------------------------------------------------------------- runtime
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
APP_VERSION=0.1.0

# ----------------------------------------------------------------- logging
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
# Human-readable logs locally; leave unset (JSON) in production.
LOG_PRETTY=true

# ---------------------------------------------------------------- database
# Matches the credentials and port in docker-compose.yml. Start it with: npm run db:up
# Port 5544, not 5432, so the container does not clash with an existing local PostgreSQL.
# `127.0.0.1` rather than `localhost`: on Windows, `localhost` resolves to `::1` first and
# Docker Desktop's IPv6 listener does not reliably forward, which appears as an
# intermittent "Can't reach database server" while the container reports healthy.
DATABASE_URL=postgresql://sfs:sfs_local_dev_password@127.0.0.1:5544/school_finance?schema=public

# Separate database used by integration tests; a test run truncates it.
TEST_DATABASE_URL=postgresql://sfs:sfs_local_dev_password@127.0.0.1:5544/school_finance_test?schema=public

# ---------------------------------------------------------------- security
# Exact origins allowed to call the API, comma-separated. No wildcards in production.
CORS_ORIGINS=http://localhost:5173

# Global rate limit per IP.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300

# Maximum accepted JSON body size.
JSON_BODY_LIMIT=256kb

# Number of reverse proxies in front of the API. 0 when running directly.
# Set this correctly in production, or X-Forwarded-For can be forged to evade rate limits.
TRUST_PROXY_HOPS=0

# Seconds allowed for in-flight requests to finish during shutdown.
SHUTDOWN_TIMEOUT_SECONDS=15

# ---------------------------------------------------------- authentication
# Signing key for access tokens. Deliberately has no default in any environment: a
# default signing key is a forgeable session, and a value committed to the repository
# eventually reaches production. At least 32 characters.
#   Generate: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# Left too short to validate on purpose: copying this file must fail loudly rather than
# start the API on a signing key that is published in the repository.
JWT_ACCESS_SECRET=replace-me

# AES-256-GCM key protecting TOTP secrets at rest: exactly 32 bytes, base64-encoded.
# Treat it like a database password. If it is lost or changed, every already-enrolled
# authenticator stops verifying and those users must re-enrol.
#   Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=replace-me-with-exactly-32-random-bytes-base64-encoded

# Token lifetimes. The access token is short because it bounds how long a *stolen* token
# is usable -- revocation itself is immediate, since every request re-reads the session.
# The refresh token is the sliding session and rotates on every use.
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Validity of the intermediate token issued between a correct password and a completed
# MFA challenge. Long enough to open an authenticator app, no longer.
MFA_CHALLENGE_TTL_MINUTES=5

# Label shown beside the code in the user's authenticator app.
MFA_ISSUER=School Finance System

# Brute-force protection. A failed second factor counts towards the same threshold, so
# six digits cannot be guessed without limit.
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15

# Validity of a password-reset link. Short, because it travels by email.
PASSWORD_RESET_TTL_MINUTES=60

# Refresh-token cookie. `Secure` is forced on in production regardless of this file, and
# the cookie is scoped to the refresh routes so it is not sent with ordinary API calls.
# SameSite=None is rejected outright in production: serve the web client and the API from
# the same site, or add CSRF protection before relaxing it.
REFRESH_COOKIE_NAME=sfs_refresh
REFRESH_COOKIE_SAMESITE=strict
# Only needed when the API and the web client sit on different subdomains.
# REFRESH_COOKIE_DOMAIN=.example.ac.rw
