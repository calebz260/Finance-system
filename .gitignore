# Dependencies
node_modules/
.pnp/
.pnp.js

# Build output
dist/
build/
*.tsbuildinfo
.vite/

# Environment / secrets  -- NEVER commit real credentials
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets/

# Test & coverage artifacts
coverage/
.nyc_output/
test-results/
playwright-report/

# Runtime data
logs/
*.log
npm-debug.log*
pids/
*.pid

# Uploaded files (proof-of-payment, bank statements) are never committed
uploads/
storage/local/
# The default UPLOAD_STORAGE_PATH, and where the test suite writes the files it uploads.
var/

# Prisma local artifacts
prisma/*.db
prisma/*.db-journal

# Generated Prisma client -- regenerated by `npm run db:generate` (and by the
# pre-build/pre-test hooks), so it is never committed.
backend/src/generated/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
